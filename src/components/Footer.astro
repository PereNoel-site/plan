---
const links = [
  { href: '#realisations', label: 'Réalisations' },
  { href: '#prestations', label: 'Prestations' },
  { href: '#tarifs', label: 'Tarifs' },
  { href: '#methode', label: 'Méthode' },
  { href: '#faq', label: 'FAQ' },
];
---

<footer class="site-footer">
  <div class="container inner">
    <span class="brand">Plan au Naturel</span>
    <nav class="links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>
    <span class="email">planaunaturel@gmail.com</span>
    <span class="copyright">© 2026 PN Production</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-divider);
  }

  .inner {
    padding: 26px 24px;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 13px;
    color: var(--color-neutral-700);
  }

  .brand {
    font-family: var(--font-heading);
    font-size: 15px;
    color: var(--color-text);
  }

  .links {
    display: flex;
    gap: 16px;
  }

  .links a {
    color: var(--color-neutral-700);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-accent-700);
  }

  .email {
    margin-left: auto;
  }
</style>
